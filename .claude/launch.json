{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wheretogo-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "wheretogo-dev-3100",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "wheretogo-prod-3100",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "process.env.PORT='3100';import('./scripts/start-prod.mjs')"],
      "port": 3100
    }
  ]
}
