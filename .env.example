# =============================================================================
# Variáveis de Ambiente - WhereToGo (Next.js 16 + Node 22 + PostgreSQL 16/PostGIS)
# Copie para `.env` e ajuste os valores. O `.env` NUNCA deve ser commitado.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000
# Nº de proxies reversos confiáveis na frente da app (um proxy reverso = 1).
# Define qual entrada do X-Forwarded-For é o IP real (limite de tentativas e auditoria).
PROXIES_CONFIAVEIS=1
# Conexões simultâneas com o PostgreSQL POR INSTÂNCIA (o dashboard abre 6 consultas
# em paralelo). Na Vercel use 5: várias instâncias dividem o pooler do Supabase.
DB_POOL_MAX=20

# --- PostgreSQL 16 + PostGIS (lido pelo docker-compose) -----------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=wheretogo_db
# Porta exposta no host. Use outra (ex.: 5433) se já existir um PostgreSQL local na 5432.
POSTGRES_PORT=5432
# Interface do host onde a porta é publicada (127.0.0.1 = só esta máquina).
POSTGRES_BIND=127.0.0.1

# --- Conexão para app/scripts executados FORA do Docker (npm run dev / db:*) ---
# Dentro do Docker o compose monta a URL apontando para o host `postgres`.
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/wheretogo_db
# Em bancos gerenciados na nuvem (Render, Neon, Supabase, RDS), mude para `true` ou `no-verify`
DATABASE_SSL=false
# Banco dos testes de integração (é APAGADO e recriado a cada `npm run test:integration`)
DATABASE_URL_TEST=postgresql://postgres:postgres123@localhost:5432/wheretogo_test

# --- Supabase (banco do deploy na Vercel) -------------------------------------
# Painel do Supabase > Connect: o projeto tem duas URLs do pooler.
# - Aplicação na Vercel (DATABASE_URL nas variáveis do projeto): modo TRANSAÇÃO, porta 6543
#     postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:6543/postgres
#   com DATABASE_SSL=true e DB_POOL_MAX=5.
# - Migrations e seed (`npm run db:preparar`, secret SUPABASE_DB_URL_SESSAO no GitHub):
#   modo SESSÃO, porta 5432. O advisory lock das migrations não funciona no modo
#   transação, e o script recusa a porta 6543.
# Plano completo: .specs/plano-migracao-vercel-supabase.md

# --- Autenticação (JWT HS256) -------------------------------------------------
# Mínimo de 32 caracteres. Gere uma chave com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-com-32-ou-mais-caracteres
# Duração da sessão (formato aceito pelo jose: 30m, 8h, 1d...)
JWT_EXPIRES_IN=8h

# --- Seed de desenvolvimento (npm run db:seed) --------------------------------
# Senha atribuída aos usuários de teste (admin/coordenador/voluntario@wheretogo.local)
SEED_SENHA_PADRAO=WhereToGo@2026

# --- Google One Tap / Google Identity Services (opcional) ---------------------
# Quando vazio, a tela de login habilita automaticamente o modo simulado local
# de Google One Tap para testes de auto-cadastro e aprovação em 1 clique.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# --- Avisos meteorológicos oficiais do INMET (opcional) -----------------------
# Consulta https://apiprevmet3.inmet.gov.br/avisos/ativos sob demanda (quando o
# mapa é lido e a última consulta tem mais de INTERVALO_AVISOS_MIN), sem worker
# em segundo plano. "false" para de consultar; os avisos salvos ficam até vencer.
# Detalhes: .specs/plano-integracao-defesa-civil.md (seção 4.1).
INTEGRACAO_AVISOS_INMET=true
# Código IBGE do município (7 dígitos). 4314100 = Passo Fundo/RS.
MUNICIPIO_CODIGO_IBGE=4314100
INTERVALO_AVISOS_MIN=10
INMET_AVISOS_URL=https://apiprevmet3.inmet.gov.br/avisos/ativos
