# =============================================================================
# Variáveis de Ambiente - WhereToGo (Next.js 16 + Node + PostgreSQL 16)
# =============================================================================

# Configurações da Aplicação Next.js
NODE_ENV=production
APP_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Configurações do PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=wheretogo_db
POSTGRES_PORT=5432

# URL de Conexão com o Banco (Para Prisma / Drizzle / TypeORM / pg)
# Interna (entre containers Docker):
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/wheretogo_db?schema=public

# Externa (para rodar migrations da sua máquina local fora do Docker):
# DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/wheretogo_db?schema=public

# Chave Secreta para Assinatura de Tokens JWT
JWT_SECRET=sua_chave_secreta_jwt_aqui
