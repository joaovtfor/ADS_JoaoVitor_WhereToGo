# =============================================================================
# Variáveis de Ambiente - WhereToGo (Next.js 16 + Node 22 + PostgreSQL 16/PostGIS)
# Copie para `.env` e ajuste os valores. O `.env` NUNCA deve ser commitado.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- PostgreSQL 16 + PostGIS (lido pelo docker-compose) -----------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=wheretogo_db
# Porta exposta no host. Use outra (ex.: 5433) se já existir um PostgreSQL local na 5432.
POSTGRES_PORT=5432

# --- Conexão para app/scripts executados FORA do Docker (npm run dev / db:*) ---
# Dentro do Docker o compose monta a URL apontando para o host `postgres`.
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/wheretogo_db
# Banco dos testes de integração (é APAGADO e recriado a cada `npm run test:integration`)
DATABASE_URL_TEST=postgresql://postgres:postgres123@localhost:5432/wheretogo_test

# --- Autenticação (JWT HS256) -------------------------------------------------
# Mínimo de 32 caracteres. Gere uma chave com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-com-32-ou-mais-caracteres
# Duração da sessão (formato aceito pelo jose: 30m, 8h, 1d...)
JWT_EXPIRES_IN=8h

# --- Seed de desenvolvimento (npm run db:seed) --------------------------------
# Senha atribuída aos usuários de teste (admin/coordenador/voluntario@wheretogo.local)
SEED_SENHA_PADRAO=WhereToGo@2026
