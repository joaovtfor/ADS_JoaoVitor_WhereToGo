{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "framework": "nextjs",
  "buildCommand": "npm run db:migrate && npm run build",
  "headers": [
    {
      "source": "/api/public/(abrigos|alertas|categorias)",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=10, stale-while-revalidate=60, stale-if-error=300"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=10, stale-while-revalidate=60, stale-if-error=300"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
